# Google OAuth (Desktop client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_PATH=~/.config/google-workspace-mcp/token.json
# Base64 of a token.json produced by `npm run auth`. Only needed on ephemeral
# hosts (e.g. Railway) where GOOGLE_TOKEN_PATH won't survive a redeploy; see
# docs/deployment-plan.md §0.2. Leave empty for local use.
GOOGLE_TOKEN_JSON_B64=

# Features
ENABLE_GMAIL_SEND=true
ENABLE_GMAIL_DRAFTS=true
ENABLE_DOCS_APPEND=true

# Safety
DRY_RUN=false
ALLOWED_RECIPIENT_DOMAINS=          # e.g. "company.com,partner.com" (empty = any)
MAX_RECIPIENTS=50
MAX_ATTACHMENT_MB=20
ALLOWED_DOCUMENT_IDS=               # optional allowlist of doc IDs

# HTTP transport
MCP_TRANSPORT=stdio                 # stdio | http
MCP_HTTP_PORT=8080
MCP_HTTP_HOST=127.0.0.1
MCP_AUTH_TOKEN=
# Required once MCP_HTTP_HOST is not 127.0.0.1/localhost (e.g. "0.0.0.0" on
# Railway): exact public origin(s) to accept, comma-separated. Without this,
# every request carrying an Origin header is rejected once not bound to
# localhost. e.g. "https://your-app.up.railway.app"
MCP_ALLOWED_ORIGINS=

LOG_LEVEL=info
